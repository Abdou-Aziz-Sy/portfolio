        <mxCell id="2tVagF7I7-St2__tLRVU-27" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1F6FB2;strokeWidth=1;fontSize=11;" value="S2 — Suivre l&#39;état de son signalement" vertex="1">
