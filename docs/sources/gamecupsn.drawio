            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cM_isyc0d5u1pT7D2H-0-283" connectable="0" parent="cM_isyc0d5u1pT7D2H-0-281" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" value="0..*" vertex="1">
          <mxGeometry relative="1" x="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cM_isyc0d5u1pT7D2H-0-284" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF8E1;strokeColor=#C8A415;align=left;verticalAlign=top;fontSize=11;spacing=8;" value="PRINCIPE STRUCTURANT — l&#39;identité ne connaît aucun jeu. (décision 2)&lt;br&gt;User ne porte aucune donnée de jeu : tout ce qui est propre à un jeu vit dans UserGameProfile, ou sur Game.&lt;br&gt;Ajouter un jeu = une ligne dans Game, avec son trackerUrlTemplate et ses vetoRules. Aucune migration." vertex="1">
          <mxGeometry height="73" width="860" x="734.5" y="1404" as="geometry" />
        </mxCell>
        <mxCell id="cM_isyc0d5u1pT7D2H-0-285" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF8E1;strokeColor=#C8A415;align=left;verticalAlign=top;fontSize=11;spacing=8;" value="Team = l&#39;équipe permanente. TeamMember = l&#39;appartenance d&#39;un joueur à une Team.&lt;br&gt;TeamMember.gameId est DÉLIBÉRÉMENT dupliqué depuis Team : c&#39;est le seul moyen d&#39;imposer « une seule équipe&lt;br&gt;par joueur et par jeu » par la contrainte {U} (userId, gameId). (décision 10)" vertex="1">
          <mxGeometry height="73" width="860" x="734.5" y="1487" as="geometry" />
        </mxCell>
        <mxCell id="cM_isyc0d5u1pT7D2H-0-286" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF8E1;strokeColor=#C8A415;align=left;verticalAlign=top;fontSize=11;spacing=8;" value="Party = une équipe engagée dans UN tournoi. PartyPlayer = ses joueurs alignés. (décisions 11, 37, 46)&lt;br&gt;Party.teamId est facultatif : vide = équipe temporaire, montée pour ce seul tournoi, nommée « Équipe N »&lt;br&gt;par défaut. Les joueurs d&#39;une Party n&#39;appartiennent pas forcément à sa Team." vertex="1">
          <mxGeometry height="73" width="860" x="734.5" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="cM_isyc0d5u1pT7D2H-0-287" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF8E1;strokeColor=#C8A415;align=left;verticalAlign=top;fontSize=11;spacing=8;" value="Un joueur, une seule composition par tournoi. (décision 47)&lt;br&gt;PartyPlayer.tournamentId est dupliqué depuis Party pour poser {U} (tournamentId, userId) : même principe&lt;br&gt;que TeamMember.gameId. Sans elle, un joueur pourrait s&#39;aligner dans deux équipes du même tournoi." vertex="1">
          <mxGeometry height="73" width="860" x="734.5" y="1653" as="geometry" />
        </mxCell>
        <mxCell id="cM_isyc0d5u1pT7D2H-0-288" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF8E1;strokeColor=#C8A415;align=left;verticalAlign=top;fontSize=11;spacing=8;" value="Match pointe vers Party, jamais vers Team : ce qui s&#39;affronte est une participation à CE tournoi.&lt;br&gt;finalMap est conservé — une carte peut exister sans veto. Le veto est optionnel (Tournament.vetoEnabled) ;&lt;br&gt;ses RÈGLES sont un JSON (vetoRules), son DÉROULÉ une ligne MatchVeto par action. (décisions 41 à 43)" vertex="1">
          <mxGeometry height="73" width="860" x="734.5" y="1736" as="geometry" />
        </mxCell>
        <mxCell id="cM_isyc0d5u1pT7D2H-0-289" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF8E1;strokeColor=#C8A415;align=left;verticalAlign=top;fontSize=11;spacing=8;" value="Aucune valeur dérivée n&#39;est stockée. (décision 44)&lt;br&gt;Pas de compteur de membres, pas de table de palmarès : ils se calculent depuis TeamMember, Match, Party&lt;br&gt;et PartyPlayer. Un compteur stocké finit toujours par diverger de la réalité." vertex="1">
          <mxGeometry height="73" width="860" x="734.5" y="1819" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
