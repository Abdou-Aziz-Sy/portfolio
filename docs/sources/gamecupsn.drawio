        <mxCell id="2tVagF7I7-St2__tLRVU-26" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1F6FB2;strokeWidth=1;fontSize=11;" value="S1 — Signaler un utilisateur, une équipe ou un match" vertex="1">
