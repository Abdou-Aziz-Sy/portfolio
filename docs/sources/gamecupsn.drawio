        <mxCell id="2tVagF7I7-St2__tLRVU-30" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#1F2933;strokeWidth=2;" value="Abonné" vertex="1">
